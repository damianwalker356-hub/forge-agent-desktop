# hex1 — stage 1 of the Forge bootstrap, written in hex0 format (every jump offset computed by hand).
# Same input language as hex0 plus:   :name   defines a label at the current output offset
#                                     %name   emits a 32-bit little-endian displacement to the label,
#                                             relative to the end of those 4 bytes (jmp/call/lea rel32)
#                                     @       emits the total output size as 32 bits (for p_filesz)
# Two passes over the input (held in memory); output is buffered and written once at the end.
# Memory (one RWX segment, 32 MB): input 0x500000, output 0xD00000, labels 0x1500000 (40-byte entries:
# 32-byte zero-padded name + 8-byte offset), name scratch 0x1800000.
# Registers: r15 input base, r14 input length, r13 input cursor, r12 output offset, rbx pass (0/1),
#            rbp label count, r9 nibble pending, r10 nibble/byte, r8 total size after pass 0.
# ---- ELF64 header ----
7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00
02 00 3e 00 01 00 00 00
78 00 40 00 00 00 00 00
40 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00
40 00 38 00 01 00 00 00 00 00 00 00
# ---- program header ----
01 00 00 00 07 00 00 00
00 00 00 00 00 00 00 00
00 00 40 00 00 00 00 00
00 00 40 00 00 00 00 00
eb 02 00 00 00 00 00 00                 ; p_filesz 0x2eb (747 bytes: 120 header + 627 code/data)
00 00 00 02 00 00 00 00                 ; p_memsz 32 MB
00 10 00 00 00 00 00 00
# ---- code (offsets relative to entry) ----
41 bf 00 00 50 00       ; 000 mov r15d,0x500000
4d 31 f6                ; 006 xor r14,r14
# readloop:
31 c0                   ; 009 xor eax,eax               SYS_read
31 ff                   ; 00b xor edi,edi
4b 8d 34 37             ; 00d lea rsi,[r15+r14]
ba 00 00 10 00          ; 011 mov edx,0x100000
0f 05                   ; 016 syscall
48 85 c0                ; 018 test rax,rax
7e 05                   ; 01b jle readdone
49 01 c6                ; 01d add r14,rax
eb e7                   ; 020 jmp readloop
# readdone:
31 ed                   ; 022 xor ebp,ebp               no labels yet
31 db                   ; 024 xor ebx,ebx               pass 0
# passstart:
4d 89 fd                ; 026 mov r13,r15
4d 31 e4                ; 029 xor r12,r12
45 31 c9                ; 02c xor r9d,r9d
# mainloop:
4b 8d 04 37             ; 02f lea rax,[r15+r14]
49 39 c5                ; 033 cmp r13,rax
0f 83 f8 00 00 00       ; 036 jae passend
41 0f b6 45 00          ; 03c movzx eax,byte [r13]
49 ff c5                ; 041 inc r13
3c 23                   ; 044 cmp al,'#'
74 4f                   ; 046 je comment
3c 3b                   ; 048 cmp al,';'
74 4b                   ; 04a je comment
3c 3a                   ; 04c cmp al,':'
0f 84 61 00 00 00       ; 04e je deflabel
3c 25                   ; 054 cmp al,'%'
0f 84 9f 00 00 00       ; 056 je reflabel
3c 40                   ; 05c cmp al,'@'
0f 84 bf 00 00 00       ; 05e je totalsize
8d 48 d0                ; 064 lea ecx,[rax-0x30]
83 f9 09                ; 067 cmp ecx,9
76 0d                   ; 06a jbe digit
0c 20                   ; 06c or al,0x20
8d 48 9f                ; 06e lea ecx,[rax-0x61]
83 f9 05                ; 071 cmp ecx,5
77 b9                   ; 074 ja mainloop
83 c1 0a                ; 076 add ecx,10
# digit:
45 85 c9                ; 079 test r9d,r9d
75 08                   ; 07c jnz second
41 89 ca                ; 07e mov r10d,ecx
41 ff c1                ; 081 inc r9d
eb a9                   ; 084 jmp mainloop
# second:
41 c1 e2 04             ; 086 shl r10d,4
41 09 ca                ; 08a or r10d,ecx
45 31 c9                ; 08d xor r9d,r9d
e8 ca 00 00 00          ; 090 call emitbyte
eb 98                   ; 095 jmp mainloop
# comment: skip to end of line
4b 8d 04 37             ; 097 lea rax,[r15+r14]
49 39 c5                ; 09b cmp r13,rax
0f 83 90 00 00 00       ; 09e jae passend
41 0f b6 45 00          ; 0a4 movzx eax,byte [r13]
49 ff c5                ; 0a9 inc r13
3c 0a                   ; 0ac cmp al,0x0a
75 e7                   ; 0ae jne comment
e9 7a ff ff ff          ; 0b0 jmp mainloop
# deflabel:
e8 cf 00 00 00          ; 0b5 call readname
85 db                   ; 0ba test ebx,ebx
0f 85 6d ff ff ff       ; 0bc jnz mainloop               pass 1: labels already known
48 6b c5 28             ; 0c2 imul rax,rbp,40
48 05 00 00 50 01       ; 0c6 add rax,0x1500000
be 00 00 80 01          ; 0cc mov esi,0x1800000
48 8b 0e                ; 0d1 mov rcx,[rsi]
48 89 08                ; 0d4 mov [rax],rcx
48 8b 4e 08             ; 0d7 mov rcx,[rsi+8]
48 89 48 08             ; 0db mov [rax+8],rcx
48 8b 4e 10             ; 0df mov rcx,[rsi+16]
48 89 48 10             ; 0e3 mov [rax+16],rcx
48 8b 4e 18             ; 0e7 mov rcx,[rsi+24]
48 89 48 18             ; 0eb mov [rax+24],rcx
4c 89 60 20             ; 0ef mov [rax+32],r12
48 ff c5                ; 0f3 inc rbp
e9 34 ff ff ff          ; 0f6 jmp mainloop
# reflabel:
e8 89 00 00 00          ; 0fb call readname
85 db                   ; 100 test ebx,ebx
74 16                   ; 102 jz pass0ref
e8 ba 00 00 00          ; 104 call lookup                 rax = label offset
4c 29 e0                ; 109 sub rax,r12
48 83 e8 04             ; 10c sub rax,4
e8 5b 00 00 00          ; 110 call emit32
e9 15 ff ff ff          ; 115 jmp mainloop
# pass0ref:
49 83 c4 04             ; 11a add r12,4
e9 0c ff ff ff          ; 11e jmp mainloop
# totalsize:
85 db                   ; 123 test ebx,ebx
74 f3                   ; 125 jz pass0ref
4c 89 c0                ; 127 mov rax,r8
e8 41 00 00 00          ; 12a call emit32
e9 fb fe ff ff          ; 12f jmp mainloop
# passend:
85 db                   ; 134 test ebx,ebx
75 0a                   ; 136 jnz finish
4d 89 e0                ; 138 mov r8,r12                  remember total size
ff c3                   ; 13b inc ebx
e9 e4 fe ff ff          ; 13d jmp passstart
# finish: write(1, output, r12); exit(0)
b8 01 00 00 00          ; 142 mov eax,1
bf 01 00 00 00          ; 147 mov edi,1
be 00 00 d0 00          ; 14c mov esi,0xD00000
4c 89 e2                ; 151 mov rdx,r12
0f 05                   ; 154 syscall
b8 3c 00 00 00          ; 156 mov eax,60
31 ff                   ; 15b xor edi,edi
0f 05                   ; 15d syscall
# emitbyte: r10b -> output (pass 1 only); r12++
85 db                   ; 15f test ebx,ebx
74 09                   ; 161 jz skipemit
b8 00 00 d0 00          ; 163 mov eax,0xD00000
46 88 14 20             ; 168 mov [rax+r12],r10b
49 ff c4                ; 16c inc r12                    (skipemit)
c3                      ; 16f ret
# emit32: eax -> 4 little-endian bytes
41 89 c3                ; 170 mov r11d,eax
b9 04 00 00 00          ; 173 mov ecx,4
45 89 da                ; 178 mov r10d,r11d              (emit32loop)
e8 df ff ff ff          ; 17b call emitbyte
41 c1 eb 08             ; 180 shr r11d,8
ff c9                   ; 184 dec ecx
75 f0                   ; 186 jnz emit32loop
c3                      ; 188 ret
# readname: copy the name at the cursor (up to 31 chars, ends at any char <= space) into scratch
bf 00 00 80 01          ; 189 mov edi,0x1800000
31 c0                   ; 18e xor eax,eax
48 89 07                ; 190 mov [rdi],rax
48 89 47 08             ; 193 mov [rdi+8],rax
48 89 47 10             ; 197 mov [rdi+16],rax
48 89 47 18             ; 19b mov [rdi+24],rax
31 c9                   ; 19f xor ecx,ecx
4b 8d 04 37             ; 1a1 lea rax,[r15+r14]          (nameloop)
49 39 c5                ; 1a5 cmp r13,rax
73 18                   ; 1a8 jae namedone
41 0f b6 45 00          ; 1aa movzx eax,byte [r13]
3c 20                   ; 1af cmp al,0x20
76 0f                   ; 1b1 jbe namedone
83 f9 1f                ; 1b3 cmp ecx,31
73 05                   ; 1b6 jae skipchar
88 04 0f                ; 1b8 mov [rdi+rcx],al
ff c1                   ; 1bb inc ecx
49 ff c5                ; 1bd inc r13                    (skipchar)
eb df                   ; 1c0 jmp nameloop
c3                      ; 1c2 ret                        (namedone)
# lookup: scratch name -> rax = offset, or print an error and exit 1
31 d2                   ; 1c3 xor edx,edx
48 39 ea                ; 1c5 cmp rdx,rbp                (lookuploop)
73 3f                   ; 1c8 jae notfound
48 6b c2 28             ; 1ca imul rax,rdx,40
48 05 00 00 50 01       ; 1ce add rax,0x1500000
be 00 00 80 01          ; 1d4 mov esi,0x1800000
48 8b 0e                ; 1d9 mov rcx,[rsi]
48 3b 08                ; 1dc cmp rcx,[rax]
75 23                   ; 1df jne nextlabel
48 8b 4e 08             ; 1e1 mov rcx,[rsi+8]
48 3b 48 08             ; 1e5 cmp rcx,[rax+8]
75 19                   ; 1e9 jne nextlabel
48 8b 4e 10             ; 1eb mov rcx,[rsi+16]
48 3b 48 10             ; 1ef cmp rcx,[rax+16]
75 0f                   ; 1f3 jne nextlabel
48 8b 4e 18             ; 1f5 mov rcx,[rsi+24]
48 3b 48 18             ; 1f9 cmp rcx,[rax+24]
75 05                   ; 1fd jne nextlabel
48 8b 40 20             ; 1ff mov rax,[rax+32]
c3                      ; 203 ret
48 ff c2                ; 204 inc rdx                    (nextlabel)
eb bc                   ; 207 jmp lookuploop
# notfound: write "hex1: undefined label: " + name + "\n" to stderr, exit 1
b8 01 00 00 00          ; 209 mov eax,1
bf 02 00 00 00          ; 20e mov edi,2
48 8d 35 41 00 00 00    ; 213 lea rsi,[rip+msg]
ba 17 00 00 00          ; 21a mov edx,23
0f 05                   ; 21f syscall
b8 01 00 00 00          ; 221 mov eax,1
bf 02 00 00 00          ; 226 mov edi,2
be 00 00 80 01          ; 22b mov esi,0x1800000
ba 20 00 00 00          ; 230 mov edx,32
0f 05                   ; 235 syscall
b8 01 00 00 00          ; 237 mov eax,1
bf 02 00 00 00          ; 23c mov edi,2
48 8d 35 2a 00 00 00    ; 241 lea rsi,[rip+nl]
ba 01 00 00 00          ; 248 mov edx,1
0f 05                   ; 24d syscall
b8 3c 00 00 00          ; 24f mov eax,60
bf 01 00 00 00          ; 254 mov edi,1
0f 05                   ; 259 syscall
# msg: "hex1: undefined label: " (23 bytes)
68 65 78 31 3a 20 75 6e 64 65 66 69 6e 65 64 20 6c 61 62 65 6c 3a 20   ; 25b
0a                      ; 272 nl
