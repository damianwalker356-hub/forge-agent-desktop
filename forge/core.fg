\ core.fg — Forge 1.0 standard library, written in Forge itself.
\ Load with:  ./forge core.fg yourprogram.fg
\ Everything below is built from kernel primitives; nothing here is machine code.

\ ---------------------------------------------------------------- compiler access
: ,            ( n -- )          here ! 8 allot ;
: c,           ( c -- )          here c! 1 allot ;
: immediate    ( -- )            latest 8 + dup @ 1 or swap ! ;
: compile-only ( -- )            latest 8 + dup @ 2 or swap ! ;
: >cfa         ( entry -- xt )   dup 16 + @ 7 + -8 and + 24 + @ ;
: >name        ( entry -- addr len ) dup 24 + swap 16 + @ ;
: immediate?   ( entry -- flag ) 8 + @ 1 and ;
: [compile]    ( "name" -- )     ' compile, ; immediate
: ?found       ( entry -- entry ) dup 0= if ." postpone: unknown word" cr abort then ;
: postpone     ( "name" -- )
    token find ?found
    dup immediate? if >cfa compile,
    else >cfa [compile] literal ['] compile, compile, then ; immediate
: recurse      ( -- )            latest >cfa compile, ; immediate
: char         ( "c" -- c )      token drop c@ ;
: [char]       ( "c" -- )        char [compile] literal ; immediate
: constant     ( n "name" -- )   create latest >cfa 2 + ! ;   \ patch the imm64 in CREATE's push stub
: array        ( n "name" -- )   create cells allot ;          \ name ( -- addr ); element i at  addr i cells +

\ ---------------------------------------------------------------- stack
: nip    ( a b -- b )          swap drop ;
: tuck   ( a b -- b a b )      swap over ;
: -rot   ( a b c -- c a b )    rot rot ;
: 2dup   ( a b -- a b a b )    over over ;
: 2drop  ( a b -- )            drop drop ;
: 2swap  ( a b c d -- c d a b ) rot >r rot r> ;
: pick   ( ... n -- ... x )    1+ cells sp@ + @ ;
: 2over  ( a b c d -- a b c d a b ) 3 pick 3 pick ;
: depth  ( -- n )              sp@ 0x1C000000 swap - 8 / ;
: ?dup   ( n -- n n | 0 )      dup if dup then ;

\ ---------------------------------------------------------------- integers
: true 1 ;   : false 0 ;   : bl 32 ;
: 0<  0 < ;  : 0>  0 > ;   : 0<> 0 <> ;
: abs    ( n -- |n| )          dup 0< if negate then ;
: min    ( a b -- min )        2dup > if swap then drop ;
: max    ( a b -- max )        2dup < if swap then drop ;
: /mod   ( a b -- rem quot )   2dup mod -rot / ;
: */     ( a b c -- a*b/c )    >r * r> / ;
: 2*     1 lshift ;
: 2/     2 / ;
: within ( n lo hi -- flag )   over - >r - r> u< ;
: cell+  8 + ;
: +!     ( n addr -- )         dup @ rot + swap ! ;
: sq     ( n -- n*n )          dup * ;

\ ---------------------------------------------------------------- memory
: fill   ( addr n byte -- )    >r begin dup 0> while over r@ swap c! 1- swap 1+ swap repeat 2drop r> drop ;
: erase  ( addr n -- )         0 fill ;
: allocate ( n -- addr )       0 swap 3 0x22 -1 0 9 syscall ;      \ mmap: fresh zeroed memory, any size
: free   ( addr n -- )         0 0 0 0 11 syscall drop ;           \ munmap

\ ---------------------------------------------------------------- strings
: count  ( caddr -- addr len ) dup 1+ swap c@ ;
: zlen   ( zaddr -- len )      0 begin 2dup + c@ while 1+ repeat nip ;
: zcount ( zaddr -- addr len ) dup zlen ;
: >z     ( addr len -- zaddr ) here >r dup >r here swap cmove r> allot 0 c, r> ;
: z"     ( "text" -- zaddr )   [char] " parse 2dup + 0 swap c! 1 0x1C212118 +! drop
                               state@ if [compile] literal then ; immediate
: str=   ( a1 n1 a2 n2 -- flag )
    rot over <> if 2drop drop false exit then
    begin dup 0> while
        >r over c@ over c@ <> if r> drop 2drop false exit then
        1+ swap 1+ swap r> 1-
    repeat drop 2drop true ;

\ ---------------------------------------------------------------- output
: spaces   ( n -- )            begin dup 0> while space 1- repeat drop ;
: ndigits  ( n -- count )      dup 0< if negate 1 else 0 then swap
                               begin 10 / swap 1+ swap dup 0= until drop ;
: .r       ( n width -- )      over ndigits - spaces (.) ;
: hexdigit ( n -- c )          dup 10 < if 48 else 55 then + ;
: hex.     ( n -- )            16 0 do dup 60 rshift 15 and hexdigit emit 4 lshift loop drop space ;
: dump     ( addr n -- )       0 do dup i + c@ dup 16 / hexdigit emit 15 and hexdigit emit space loop drop cr ;
: .s       ( -- )              [char] < emit depth (.) [char] > emit space
                               depth 0> if depth 0 do depth 1- i - pick . loop then cr ;

\ ---------------------------------------------------------------- input
variable keybuf
: key      ( -- c )            0 keybuf 1 0 0 0 0 syscall 0 <= if -1 else keybuf c@ then ;

\ ---------------------------------------------------------------- floats (IEEE doubles share the data stack)
: fnegate  0x8000000000000000 xor ;
: fabs     dup 0< if fnegate then ;
: fdup dup ;  : fdrop drop ;  : fswap swap ;  : fover over ;
: f<=  f> not ;   : f>=  f< not ;   : f<>  f= not ;
: fmin     2dup f> if swap then drop ;
: fmax     2dup f< if swap then drop ;
: fsquare  dup f* ;
: floor    ( f -- f )  dup f>s s>f 2dup f< if 1.0 f- then nip ;
: f**      ( a b -- a^b )  swap fln f* fexp ;              \ a > 0
: ftan     ( f -- tan f )  dup fsin swap fcos f/ ;
: pi       3.141592653589793 ;
: deg>rad  pi f* 180.0 f/ ;
: rad>deg  180.0 f* pi f/ ;
\ print with 6 decimals (|f| < 2^63); NaN/inf print garbage — see README
: f.       ( f -- )
    dup 0< if [char] - emit fnegate then
    dup f>s dup (.) [char] . emit
    s>f f- 1000000.0 f* fround dup 1000000 >= if drop 999999 then
    100000 begin dup 0> while 2dup / 10 mod (.) 10 / repeat 2drop space ;
: f.3      ( f -- )  dup 0< if [char] - emit fnegate then
    dup f>s dup (.) [char] . emit s>f f- 1000.0 f* fround dup 1000 >= if drop 999 then
    100 begin dup 0> while 2dup / 10 mod (.) 10 / repeat 2drop space ;

\ ---------------------------------------------------------------- files (thin wrappers over Linux syscalls)
0 constant O_RDONLY   1 constant O_WRONLY   2 constant O_RDWR
64 constant O_CREAT   512 constant O_TRUNC  1024 constant O_APPEND
: open-file   ( zaddr flags mode -- fd|-errno )  0 0 0 2 syscall ;
: create-file ( zaddr -- fd )   O_WRONLY O_CREAT or O_TRUNC or 420 open-file ;
: close-file  ( fd -- )         0 0 0 0 0 3 syscall drop ;
: read-file   ( fd addr n -- nread )  0 0 0 0 syscall ;
: write-file  ( fd addr n -- nwritten ) 0 0 0 1 syscall ;
: exit-code   ( n -- )          0 0 0 0 0 60 syscall ;

\ ---------------------------------------------------------------- program arguments & time
: argc  ( -- n )        0x1C212148 @ @ ;
: argv  ( i -- zaddr )  1+ cells 0x1C212148 @ + @ ;
create tspec 16 allot
: now-ns ( -- ns )      1 tspec 0 0 0 0 228 syscall drop tspec @ 1000000000 * tspec 8 + @ + ;
: wall-ns ( -- ns )     0 tspec 0 0 0 0 228 syscall drop tspec @ 1000000000 * tspec 8 + @ + ;   \ CLOCK_REALTIME

\ ---------------------------------------------------------------- control structures defined in the language
: case     0 ; immediate
: again    0 postpone literal postpone until ; immediate
: of       postpone over postpone = postpone if postpone drop ; immediate
: endof    postpone else 1+ ; immediate
: endcase  postpone drop begin dup 0> while postpone then 1- repeat drop ; immediate
